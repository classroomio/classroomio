#!/usr/bin/env bash
set -euo pipefail

SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CACHE="${CIO_VIDEO_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/cio-video}"
VENV="${CIO_VIDEO_VENV:-$CACHE/venv}"

if [ ! -x "$VENV/bin/python" ]; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q -r "$SCRIPTS/requirements.txt"
fi

PYTHONPATH="$SCRIPTS${PYTHONPATH:+:$PYTHONPATH}" exec "$VENV/bin/python" -m cio_video "$@"
