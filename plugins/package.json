    "dev": "tsc --watch",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@cio/sdk": "workspace:*"
  },
  "devDependencies": {
    "@cio/tsconfig": "workspace:*",
    "svelte": "^5.46.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.5.2"
  }
