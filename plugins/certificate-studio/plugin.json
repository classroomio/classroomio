{
  "$schema": "https://classroomio.com/schemas/plugin.v1.json",
  "manifestVersion": 1,
  "id": "com.classroomio.certificate-studio",
  "name": "Certificate Studio",
  "version": "1.0.0",
  "description": "Visual design studio for creating, customizing, and issuing verified academy certificates.",
  "publisher": "classroomio",
  "license": "MIT",
  "engines": {
    "classroomio": ">=2.0.0",
    "pluginApi": "2026-10-08"
  },
  "runtime": {
    "ui": {
      "entrypoints": {
        "designerApp": {
          "renderMode": "custom",
          "resource": "ui/studio.html"
        }
      }
    }
  },
  "permissions": {
    "required": ["certificate_templates:read", "certificate_templates:write"],
    "optional": ["certificates.issued:read", "plugin.storage:read", "plugin.storage:write"]
  },
  "contributes": {
    "pages": [
      {
        "id": "certificate-studio-app",
        "entrypoint": "designerApp",
        "title": "Certificate Studio"
      }
    ]
  },
  "dataPolicy": {
    "storesCustomerData": false,
    "retentionAfterUninstallDays": 30
  }
}
