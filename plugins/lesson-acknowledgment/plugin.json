{
  "$schema": "https://classroomio.com/schemas/plugin.v1.json",
  "manifestVersion": 1,
  "id": "com.classroomio.lesson-acknowledgment",
  "name": "Lesson Policy Acknowledgment",
  "version": "1.0.0",
  "description": "Requires learners to explicitly acknowledge policies or compliance materials upon lesson completion.",
  "publisher": "classroomio",
  "license": "MIT",
  "engines": {
    "classroomio": ">=2.0.0",
    "pluginApi": "2026-10-08"
  },
  "runtime": {
    "ui": {
      "entrypoints": {
        "ackWidget": {
          "renderMode": "custom",
          "resource": "ui/ack.html"
        }
      }
    }
  },
  "permissions": {
    "required": ["plugin.storage:read", "plugin.storage:write"]
  },
  "contributes": {
    "slots": [
      {
        "id": "lesson-ack-slot",
        "target": "lesson.after",
        "renderMode": "custom",
        "entrypoint": "ackWidget"
      }
    ]
  },
  "dataPolicy": {
    "storesCustomerData": false,
    "retentionAfterUninstallDays": 30
  }
}
