{
  "$schema": "https://classroomio.com/schemas/plugin.v1.json",
  "manifestVersion": 1,
  "id": "com.classroomio.linkedin-certificate",
  "name": "LinkedIn Certificate Share",
  "version": "1.0.0",
  "description": "Enables one-click sharing of earned course certificates directly to LinkedIn profile certifications.",
  "publisher": "classroomio",
  "license": "MIT",
  "engines": {
    "classroomio": ">=2.0.0",
    "pluginApi": "2026-10-08"
  },
  "permissions": {
    "required": ["certificates.issued:read"]
  },
  "contributes": {
    "actions": [
      {
        "id": "linkedin.share-certificate",
        "target": "certificate.actions",
        "renderMode": "host",
        "label": "Add to LinkedIn",
        "icon": "linkedin",
        "actionType": "openUrl",
        "urlTemplate": "https://www.linkedin.com/profile/add?startTask=CERTIFICATION_NAME&name={courseTitle}&organizationName={orgName}&certUrl={certUrl}"
      }
    ]
  },
  "dataPolicy": {
    "storesCustomerData": false,
    "retentionAfterUninstallDays": 30
  }
}
