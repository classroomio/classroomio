{
  "name": "@cio/jobs-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc && tsc-alias",
    "dev": "pnpm --filter @cio/jobs-worker --parallel \"/^dev:.*/\"",
    "dev:tsc": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:media": "tsx watch src/workers/media.ts",
    "dev:media-transcribe": "tsx watch src/workers/media-transcribe.ts",
    "dev:emails": "tsx watch src/workers/emails.ts",
    "dev:notifications": "tsx watch src/workers/notifications.ts",
    "dev:webhooks": "tsx watch src/workers/webhooks.ts",
    "dev:maintenance": "tsx watch src/workers/maintenance.ts",
    "dev:agent-course-generation": "tsx watch src/workers/agent-course-generation.ts",
    "dev:audience": "tsx watch src/workers/audience.ts",
    "dev:onboarding-starter": "tsx watch src/workers/onboarding-starter.ts",
    "dev:course-build": "tsx watch src/workers/course-build.ts",
    "start": "node dist/index.js",
    "start:media": "node dist/workers/media.js",
    "start:media-transcribe": "node dist/workers/media-transcribe.js",
    "start:emails": "node dist/workers/emails.js",
    "start:notifications": "node dist/workers/notifications.js",
    "start:webhooks": "node dist/workers/webhooks.js",
    "start:maintenance": "node dist/workers/maintenance.js",
    "start:agent-course-generation": "node dist/workers/agent-course-generation.js",
    "start:audience": "node dist/workers/audience.js",
    "start:onboarding-starter": "node dist/workers/onboarding-starter.js",
    "start:course-build": "node dist/workers/course-build.js",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "format": "prettier --write .",
    "dev:media-hls": "tsx watch src/workers/media-hls.ts",
    "start:media-hls": "node dist/workers/media-hls.js",
    "dev:youtube-captions": "tsx watch src/workers/youtube-captions.ts",
    "start:youtube-captions": "node dist/workers/youtube-captions.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.388.0",
    "@aws-sdk/s3-request-presigner": "^3.675.0",
    "@cio/core": "workspace:*",
    "@cio/course-builder": "workspace:*",
    "@cio/db": "workspace:*",
    "@cio/email": "workspace:*",
    "@cio/jobs": "workspace:*",
    "@cio/tracking": "workspace:*",
    "@cio/utils": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^16.3.1",
    "ioredis": "^5.4.1",
    "openai": "^6.36.0",
    "playwright-core": "1.57.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.5.2",
    "vitest": "^1.2.2",
    "zod": "^4.1.8"
  }
}
