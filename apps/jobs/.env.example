# ────────────────────────────────────────────────────────────────────────────
# @cio/jobs-worker — BullMQ worker process
#
# The worker shares most settings with apps/api. The simplest setup is to
# symlink or copy apps/api/.env, then add OPENAI_API_KEY if you want
# transcription:
#
#   ln -s ../api/.env .env
#
# This file documents the env vars the worker actually reads, so you know what
# to add when running it standalone (e.g. in a separate container).
# ────────────────────────────────────────────────────────────────────────────

# Required ────────────────────────────────────────────────────────────────────
# Redis is the BullMQ broker. The worker boot fails fast if this is missing.
# Must point at the same Redis instance the API enqueues into.
REDIS_URL="redis://localhost:6379"

# Postgres connection used for media_job / job_step / dead_letter_job writes.
DATABASE_URL=""

# Object storage ──────────────────────────────────────────────────────────────
# Required for the media worker (probe / thumbnail / extract-audio jobs need to
# stream the source video out of the videos bucket and write artifacts back).
# Mirror these from apps/api/.env.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_FORCE_PATH_STYLE=""
OBJECT_STORAGE_BUCKET_VIDEOS=""
OBJECT_STORAGE_BUCKET_DOCUMENTS=""
OBJECT_STORAGE_BUCKET_MEDIA=""
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=""
OBJECT_STORAGE_PUBLIC_ENDPOINT=""

# Cloudflare R2 fallback (only set if you're using R2 instead of another S3-compatible store).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_IMAGE_BUCKET_DOMAIN=""

# Email provider (required for the emails worker) ────────────────────────────
# Read by @cio/email inside the worker. The API also has its own SMTP_* set
# for auth-flow emails (forgot password, verify email, etc.) that have to send
# synchronously — both processes can point at the same SMTP server.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SENDER=""

# Optional Zoho ZeptoMail token. When set, @cio/email uses Zoho instead of
# nodemailer/SMTP.
# ZOHO_TOKEN=""

# Transcription (optional) ───────────────────────────────────────────────────
# When unset, transcribe-audio jobs no-op (the rest of the media pipeline
# still runs).
OPENAI_API_KEY=""

# Concurrency tuning (optional) ──────────────────────────────────────────────
# Override how many jobs each worker process handles in parallel.
# MEDIA_WORKER_CONCURRENCY="2"
# TRANSCRIBE_WORKER_CONCURRENCY="1"
# EMAIL_WORKER_CONCURRENCY="5"

# HLS encoding — adaptive bitrate ladder (optional) ──────────────────────────
# Uploaded lesson videos are transcoded into an HLS ladder by a disposable
# encoder machine on Fly. The dispatcher lives in this worker; the encode runs
# elsewhere, so this process never runs ffmpeg for HLS.
#
# Required for the dispatcher to mint the per-job token the encoder
# authenticates its callbacks with. MUST be byte-identical to the value in
# apps/api/.env — if the two differ the machine boots, encodes the whole video,
# then every callback 401s and the asset is stranded in `converting`.
HLS_SIGNING_SECRET=""

# All four below must be set or HLS dispatch is skipped entirely: no machine is
# started, nothing is billed, and the asset is marked `skipped` rather than
# queueing behind an encoder that does not exist. The raw upload still plays.
#
# A deploy token scoped to the encoder app: `fly tokens create deploy -a <app>`.
FLY_API_TOKEN=""
# The Fly app holding the encoder image (not an app that serves traffic — it has
# no services and nothing listens; machines are created per job).
FLY_APP_NAME="classroomio-encoder"
# Image the per-job machine boots. Publish it with:
#   fly deploy --config apps/encoder/fly.toml --dockerfile apps/encoder/Dockerfile \
#              --build-only --push --image-label v1 .
FLY_ENCODER_IMAGE="registry.fly.io/classroomio-encoder:v1"
# Where the encoder calls back to. Must be reachable FROM Fly, so a public
# origin — not localhost. For local testing, expose the API with a tunnel.
ENCODER_CALLBACK_API_URL=""

# Encoder machine tuning (optional) ──────────────────────────────────────────
# Machines created through the Machines API inherit nothing from fly.toml, so
# anything the encoder reads has to be passed by this dispatcher.
#
# Defaults to the encoder app's primary region.
# FLY_ENCODER_REGION="iad"
# Performance vCPUs. 2 vCPUs include 4GB RAM at no extra cost, so the default
# memory below is exactly the included allowance — raising it starts billing.
# FLY_ENCODER_MACHINE_CPUS="2"
# FLY_ENCODER_MACHINE_MEMORY_MB="4096"
# Ceiling on a downloaded source, enforced while streaming. Defaults to 2GiB.
# FLY_ENCODER_MAX_SOURCE_BYTES="2147483648"
# How many encodes this worker dispatches in parallel. Dispatch is cheap (claim,
# presign, mint, start a machine), so this is unrelated to concurrent encodes.
# HLS_DISPATCH_CONCURRENCY="4"

# Runtime ────────────────────────────────────────────────────────────────────
# NODE_ENV="development"

# Media worker: optional ffmpeg/ffprobe binary overrides. When unset the worker
# uses whatever is on $PATH (brew/apt install ffmpeg). Set these only if the
# binaries live somewhere non-standard.
# FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"
# FFPROBE_PATH="/opt/homebrew/bin/ffprobe"
