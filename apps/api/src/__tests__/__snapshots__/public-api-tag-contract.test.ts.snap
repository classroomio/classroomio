          "name",
          "slug",
          "color",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "templateId": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
    },
    "title": {
      "type": "string",
    },
    "type": {
      "anyOf": [
        {
          "enum": [
            "SELF_PACED",
            "LIVE_CLASS",
            "COMPLIANCE",
            "PUBLIC",
          ],
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
    },
  },
  "required": [
    "id",
    "title",
    "description",
    "overview",
    "createdAt",
    "updatedAt",
    "groupId",
    "isTemplate",
    "templateId",
    "publicForAll",
