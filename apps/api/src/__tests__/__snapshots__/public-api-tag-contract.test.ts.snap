exports[`public tag contract > ZPublicApiUpdateTag 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Only the fields you send change; renaming changes the slug, so course filters on the old slug stop matching",
  "properties": {
    "color": {
      "description": "One of the dashboard tag palette colours",
      "enum": [
        "#EF4444",
        "#F97316",
        "#F59E0B",
        "#84CC16",
        "#22C55E",
        "#14B8A6",
        "#06B6D4",
        "#3B82F6",
        "#8B5CF6",
        "#EC4899",
      ],
      "type": "string",
    },
    "description": {
      "maxLength": 240,
      "type": "string",
    },
    "groupId": {
      "description": "Tag group id from GET /tags",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string",
    },
    "name": {
      "description": "Tag name, unique in the organization. Its slug, made from the name, is what the course list's tags filter matches.",
      "maxLength": 80,
      "minLength": 1,
      "type": "string",
    },
  },
  "type": "object",
}
`;

exports[`public tag contract > ZPublicApiUpdateTagGroup 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Only the fields you send change; renaming changes the slug",
  "properties": {
    "description": {
      "maxLength": 240,
      "type": "string",
    },
    "name": {
      "description": "Tag group name, unique in the organization",
      "maxLength": 80,
      "minLength": 1,
      "type": "string",
    },
    "order": {
