# Zapier Developer Platform integration IDs (used by scripts/use-integration.mjs)
# ZAPIER_INTEGRATION_ID_STAGING=123456
# ZAPIER_INTEGRATION_ID_PRODUCTION=654321

# Integration environment variables (configured in Zapier via `npx zapier-platform env:set <version> ...`)
# CLIENT_ID="cio_client_..."
# CLIENT_SECRET="cio_secret_..."
# CIO_APP_ORIGIN="http://localhost:5173"
# CIO_API_ORIGIN="http://localhost:3002"
# Optional. Where Zapier's servers send the token and refresh grants; defaults to CIO_APP_ORIGIN.
# Set it to the tunnelled API when CIO_APP_ORIGIN is a localhost dashboard only your browser can reach.
# CIO_OAUTH_TOKEN_ORIGIN="https://<api-tunnel>"

