# iOS bundle identifier and Android package. Use your own reverse-domain ID for local and fork builds;
# official store builds read it from .env.production.
# Development and preview builds add .dev or .preview to it, so they install next to the store app.
APP_ID=""

# development, preview or production. Sets the app name, bundle ID suffix and link scheme; official store builds use production.
APP_VARIANT=""

# EAS project the app builds under (from `eas init`). Forks create their own.
EAS_PROJECT_ID=""

# ClassroomIO API the app talks to, e.g. http://localhost:3002 for a local API.
EXPO_PUBLIC_API_URL=""
