# iOS bundle identifier and Android package. Use your own reverse-domain ID for local and fork builds;
# official ClassroomIO builds set this in CI.
APP_ID=""

# development, preview or production. Sets the app name shown on the device; official store builds use production.
APP_VARIANT=""

# EAS project the app builds under (from `eas init`). Forks create their own.
EAS_PROJECT_ID=""

# ClassroomIO API the app talks to, e.g. http://localhost:3002 for a local API.
EXPO_PUBLIC_API_URL=""
