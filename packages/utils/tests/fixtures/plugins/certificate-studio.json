{
  "$schema": "https://classroomio.com/schemas/plugin-manifest.v1.json",
  "manifestVersion": 1,
  "id": "com.classroomio.certificate-studio",
  "name": "Certificate Studio",
  "version": "1.0.0",
  "description": "Design and customize professional certificate templates for your courses.",
  "publisher": "ClassroomIO",
  "icon": { "resource": "assets/certificate-studio.svg" },
  "license": "Apache-2.0",
  "engines": {
    "classroomio": ">=1.0.0",
    "pluginApi": "1.0.0"
  },
  "runtime": {
    "ui": {
      "entrypoints": {
        "studio": {
          "renderMode": "custom",
          "resource": "dist/studio.html"
        },
        "templatePicker": {
          "renderMode": "custom",
          "resource": "dist/picker.html"
        }
      }
    },
    "backend": {
      "type": "remote",
      "baseUrl": "https://certificate-studio.services.classroomio.com",
      "webhookPath": "/v1/webhooks/classroomio"
    }
  },
  "permissions": {
    "required": ["organization.profile:read", "certificate.template:read", "certificate.template:write"],
    "optional": []
  },
  "networkAccess": {
    "allowedDomains": ["https://certificate-studio.services.classroomio.com"]
  },
  "events": {
    "subscriptions": ["plugin.uninstalled", "organization.deleted"]
  },
  "contributes": {
    "navigation": [
      {
        "id": "certificate-studio-navigation",
        "title": "Certificate Studio",
        "location": "organization.settings",
        "page": "certificate-studio",
        "icon": { "resource": "assets/certificate-studio.svg" },
        "visibility": "organization.admin"
      }
    ],
    "pages": [
      {
        "id": "certificate-studio",
        "entrypoint": "studio",
        "title": "Certificate Studio"
      }
    ],
    "slots": [
      {
        "id": "certificate-studio-template-picker",
        "target": "certificate.templates",
        "renderMode": "custom",
        "entrypoint": "templatePicker",
        "title": "Organization certificate templates"
      }
    ]
  },
  "dataPolicy": {
    "storesCustomerData": true,
    "retentionAfterUninstallDays": 30,
    "privacyPolicyUrl": "https://classroomio.com/privacy"
  }
}
