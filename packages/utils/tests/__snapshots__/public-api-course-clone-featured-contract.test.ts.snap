{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "courseIds": {
      "description": "Published courses to show first, in this order (at most 4). Replaces the current list; an empty array clears it, so courses show newest first",
      "items": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string",
      },
      "maxItems": 4,
      "type": "array",
    },
  },
  "required": [
    "courseIds",
  ],
  "type": "object",
}
`;
