{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "courseId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string",
    },
    "draft": {
      "additionalProperties": false,
      "properties": {
        "course": {
          "additionalProperties": false,
          "properties": {
            "compliance": {
              "additionalProperties": false,
              "properties": {
                "framework": {
                  "anyOf": [
                    {
                      "enum": [
                        "HIPAA",
                        "OSHA",
                        "SOX",
                        "GDPR",
                        "PCI_DSS",
                        "FERPA",
                        "ISO",
                        "CUSTOM",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "gracePeriodDays": {
                  "default": 0,
                  "maximum": 365,
                  "minimum": 0,
                  "type": "integer",
                },
                "isMandatory": {
                  "default": true,
                  "type": "boolean",
                },
                "maxRetakeAttempts": {
                  "anyOf": [
                    {
                      "maximum": 9007199254740991,
                      "minimum": 1,
                      "type": "integer",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "passingScore": {
                  "default": 80,
                  "maximum": 100,
                  "minimum": 0,
