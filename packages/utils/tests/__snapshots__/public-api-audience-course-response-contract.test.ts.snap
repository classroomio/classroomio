{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "avatarUrl": {
      "type": "string",
    },
    "certificateCount": {
      "description": "Courses in this organization where the learner has earned a certificate",
      "type": "number",
    },
    "completedCount": {
      "type": "number",
    },
    "createdAt": {
      "description": "Day the member joined this organization, as a date string (e.g. "Mon Oct 05 2026")",
      "type": "string",
    },
    "email": {
      "type": "string",
    },
    "enrolledCount": {
      "type": "number",
    },
    "id": {
      "type": "number",
    },
    "lastActiveAt": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
    },
    "lastLoginAt": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
    },
    "memberStatus": {
      "description": "Lifecycle state of the membership",
      "enum": [
        "ACTIVE",
        "DEACTIVATED",
        "ARCHIVED",
      ],
      "type": "string",
    },
    "name": {
      "type": "string",
    },
    "profileId": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "null until the invited person creates an account",
    },
    "progressPercent": {
      "type": "number",
    },
    "status": {
      "description": "Invite state",
      "enum": [
        "active",
        "pending",
        "expired",
        "revoked",
      ],
      "type": "string",
    },
  },
  "required": [
    "id",
    "profileId",
    "name",
    "email",
    "avatarUrl",
    "createdAt",
    "status",
    "memberStatus",
    "lastLoginAt",
    "lastActiveAt",
    "enrolledCount",
    "completedCount",
    "progressPercent",
    "certificateCount",
  ],
  "type": "object",
}
`;

exports[`public API audience and course response contract > ZPublicApiCertificateSettingsResponse keeps its published shape > ZPublicApiCertificateSettingsResponse 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "null when nothing is stored.",
    },
    "design": {
      "additionalProperties": false,
      "description": "The default design when nothing is stored.",
      "properties": {
        "accentColor": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string",
        },
        "descriptionOverride": {
          "maxLength": 500,
          "type": "string",
        },
        "idFormat": {
          "maxLength": 40,
          "type": "string",
        },
        "signatories": {
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean",
                },
                "name": {
                  "default": "",
                  "maxLength": 80,
                  "type": "string",
                },
                "role": {
                  "default": "",
                  "maxLength": 80,
                  "type": "string",
                },
                "signatureUrl": {
                  "format": "uri",
                  "type": "string",
                },
              },
              "required": [
                "name",
                "role",
                "enabled",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "default": true,
                  "type": "boolean",
                },
                "name": {
                  "default": "",
                  "maxLength": 80,
                  "type": "string",
                },
                "role": {
                  "default": "",
                  "maxLength": 80,
                  "type": "string",
                },
                "signatureUrl": {
                  "format": "uri",
                  "type": "string",
                },
              },
              "required": [
                "name",
                "role",
                "enabled",
              ],
              "type": "object",
            },
          ],
          "type": "array",
        },
        "subtitle": {
          "maxLength": 120,
          "type": "string",
        },
        "templateId": {
          "enum": [
            "classique",
            "brutalist",
            "noir",
            "poster",
            "minimal",
          ],
          "type": "string",
        },
      },
      "required": [
        "templateId",
        "accentColor",
        "signatories",
      ],
      "type": "object",
    },
    "emailMessage": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "null when nothing is stored.",
    },
    "exerciseMinScorePercent": {
      "anyOf": [
        {
          "type": "number",
        },
        {
          "type": "null",
        },
      ],
      "description": "When nothing is stored: 100 (or the compliance passing score) if a required exercise is set, null otherwise.",
    },
    "isDownloadable": {
      "default": false,
      "description": "Controls learner downloads only; the download endpoint works either way.",
      "type": "boolean",
    },
    "requiredExerciseId": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "null when nothing is stored.",
    },
    "theme": {
      "description": "Falls back to design.templateId when nothing is stored.",
      "type": "string",
    },
    "threshold": {
      "default": 100,
      "type": "number",
    },
  },
  "required": [
    "isDownloadable",
    "theme",
    "design",
    "deadline",
    "threshold",
    "requiredExerciseId",
    "exerciseMinScorePercent",
    "emailMessage",
  ],
  "type": "object",
}
`;

