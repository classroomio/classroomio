            "type": "string",
          },
          "roleId": {
            "anyOf": [
              {
                "const": 2,
                "type": "number",
              },
              {
                "const": 3,
                "type": "number",
              },
            ],
          },
        },
        "required": [
          "roleId",
        ],
        "type": "object",
      },
      "minItems": 1,
      "type": "array",
    },
  },
  "required": [
    "members",
  ],
  "type": "object",
}
`;

