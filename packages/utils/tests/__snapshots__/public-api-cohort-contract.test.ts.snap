exports[`public API cohort request contract > ZPublicApiCreateCohortGoal keeps its published shape > ZPublicApiCreateCohortGoal 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "courseIds": {
      "items": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string",
      },
      "maxItems": 50,
      "type": "array",
    },
    "deadlineDate": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
    },
    "deadlineKind": {
      "default": "none",
      "enum": [
        "absolute",
        "relative_to_join",
        "recurring",
        "none",
      ],
      "type": "string",
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
    },
    "recurringMonths": {
      "anyOf": [
        {
          "maximum": 120,
          "minimum": 1,
          "type": "integer",
        },
        {
          "type": "null",
        },
      ],
    },
    "relativeDays": {
      "anyOf": [
        {
          "maximum": 3650,
          "minimum": 1,
          "type": "integer",
        },
        {
          "type": "null",
        },
      ],
    },
    "reminderDaysBefore": {
      "default": [
        7,
        1,
      ],
      "items": {
        "maximum": 365,
        "minimum": 0,
        "type": "integer",
      },
      "maxItems": 5,
      "type": "array",
    },
    "requiredCount": {
      "anyOf": [
        {
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
        {
          "type": "null",
        },
      ],
    },
    "scoreThreshold": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "integer",
        },
        {
          "type": "null",
        },
      ],
    },
    "teamPassRateThreshold": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "integer",
        },
        {
          "type": "null",
        },
      ],
    },
    "title": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string",
    },
    "type": {
      "enum": [
        "complete_all",
        "n_of_m",
        "score",
        "pass_rate",
        "readiness",
      ],
      "type": "string",
    },
  },
  "required": [
    "type",
    "title",
    "courseIds",
  ],
  "type": "object",
}
`;

