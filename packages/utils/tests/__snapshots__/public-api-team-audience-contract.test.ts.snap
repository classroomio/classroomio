exports[`public API team and audience update contract > ZPublicApiUpdateAudience keeps its published shape > ZPublicApiUpdateAudience 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Send email for a pending member or name for a joined member. A joined member's own email, password, username and avatar cannot be changed here; to change an admin's or tutor's role, use PUT /team/{memberId}.",
  "properties": {
    "email": {
      "description": "Pending members only: corrects the invited email and re-sends the invite unless sendEmail is false",
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string",
    },
    "name": {
      "description": "Joined members only: sets the full name on their profile. The profile is shared, so the name shows in every organization the person belongs to.",
      "maxLength": 120,
      "minLength": 3,
      "type": "string",
    },
    "sendEmail": {
      "default": true,
      "description": "Whether to email the new invite when email changes",
      "type": "boolean",
    },
  },
  "type": "object",
}
`;

