exports[`public API team and audience update contract > ZPublicApiCreateAudience keeps its published shape > ZPublicApiCreateAudience 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "courseIds": {
      "items": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string",
      },
      "type": "array",
    },
    "email": {
      "description": "One person to invite. Send this or emails, not both",
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string",
    },
    "emails": {
      "description": "Up to 1000 people to invite in one request. An address that is not valid comes back as an invalid_email row instead of failing the request. Names are not taken here; set one with PUT /audience/{memberId} after the person joins",
      "items": {
        "type": "string",
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array",
    },
    "sendEmail": {
      "default": true,
      "description": "Email the invite. Default: true; false adds them without an email.",
      "type": "boolean",
    },
  },
  "type": "object",
}
`;

