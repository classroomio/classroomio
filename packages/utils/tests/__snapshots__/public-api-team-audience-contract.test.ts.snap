`;

exports[`public API team and audience update contract > ZPublicApiUpdateTeamMember keeps its published shape > ZPublicApiUpdateTeamMember 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Send only the fields to change. Email, password, username and avatar belong to the person and cannot be changed here.",
  "properties": {
    "name": {
      "description": "Joined members only: sets the full name on their profile. The profile is shared, so the name shows in every organization the person belongs to.",
      "maxLength": 120,
      "minLength": 3,
      "type": "string",
    },
    "roleId": {
      "anyOf": [
        {
          "const": 1,
          "type": "number",
        },
        {
          "const": 2,
          "type": "number",
        },
      ],
      "description": "1 = admin, 2 = tutor. You cannot change your own role, and the organization must keep at least one admin. A pending member's invite is updated to match.",
    },
  },
  "type": "object",
}
`;
