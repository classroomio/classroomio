      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "queuedCount": {
      "description": "Invite emails queued for sending",
      "type": "number",
    },
    "requiresConfirmation": {
      "description": "true when a student address is missing from confirmedStudentEmails; nothing was sent",
      "type": "boolean",
    },
    "studentEmails": {
      "description": "Addresses that already belong to students in this organization",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
  },
  "required": [
    "requiresConfirmation",
    "studentEmails",
    "existingTeamMembers",
    "queuedCount",
    "failedEmails",
  ],
  "type": "object",
}
`;

