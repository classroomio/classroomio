exports[`public API team and audience update contract > ZPublicApiInviteTeamMembers keeps its published shape > ZPublicApiInviteTeamMembers 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "confirmedStudentEmails": {
      "default": [],
      "description": "Addresses that already belong to students and should be promoted to this role. If any student in emails is missing here, nothing is sent and the response lists them in studentEmails.",
      "items": {
        "format": "email",
        "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string",
      },
      "maxItems": 50,
      "type": "array",
    },
    "emails": {
      "description": "Up to 50 addresses, all invited with the same role",
      "items": {
        "format": "email",
        "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string",
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array",
    },
    "roleId": {
      "anyOf": [
        {
          "const": 1,
          "type": "number",
        },
        {
          "const": 2,
          "type": "number",
        },
      ],
      "description": "1 = admin, 2 = tutor",
    },
  },
  "required": [
    "emails",
    "roleId",
  ],
  "type": "object",
}
`;

