      "type": "number",
    },
    "locale": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "Language ClassroomIO is shown in for them; null until they create an account",
    },
    "name": {
      "description": "Empty until the invited person creates an account",
      "type": "string",
    },
    "profileId": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "null until the invited person creates an account",
    },
    "roleId": {
      "description": "1 = admin, 2 = tutor",
      "type": "number",
    },
    "username": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "null until the invited person creates an account",
    },
    "verified": {
      "description": "false while the invite is still pending",
      "type": "boolean",
    },
  },
  "required": [
    "id",
    "profileId",
    "name",
    "username",
    "email",
    "avatarUrl",
    "locale",
    "roleId",
    "verified",
  ],
  "type": "object",
}
`;

