exports[`public API organization customization contract > ZPublicApiUpdateOrganizationCustomization keeps its published shape 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "apps": {
      "properties": {
        "comments": {
          "description": "Show lesson comments, where the course and lesson allow them",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "auth": {
      "properties": {
        "backgroundImage": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Public http(s) URL of the login and signup page background; null restores the default. Setting one needs a paid plan.",
        },
      },
      "type": "object",
    },
    "course": {
      "properties": {
        "grading": {
          "description": "Let students see their marks in a course",
          "type": "boolean",
        },
        "newsfeed": {
          "description": "Let students open the course News Feed",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "dashboard": {
      "properties": {
        "bannerImage": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Public http(s) URL of the dashboard banner image; null removes it. Upload the image first, then send its URL.",
        },
        "bannerText": {
          "description": "Dashboard banner text; an empty string removes it",
          "maxLength": 500,
          "type": "string",
        },
        "community": {
          "description": "Show Community in the student sidebar",
          "type": "boolean",
        },
        "exercise": {
          "description": "Show Exercises in the student sidebar",
          "type": "boolean",
        },
      },
      "type": "object",
    },
  },
  "type": "object",
}
`;
