              "agg",
            ],
            "type": "object",
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
        },
        "minGroupRows": {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer",
        },
        "page": {
          "default": 1,
          "maximum": 4000,
          "minimum": 1,
          "type": "integer",
        },
        "range": {
          "default": "all",
          "enum": [
            "all",
            "7d",
            "30d",
            "90d",
          ],
          "type": "string",
        },
        "search": {
          "maxLength": 100,
          "type": "string",
        },
        "sort": {
          "default": [],
          "items": {
            "properties": {
              "dir": {
                "default": "asc",
                "enum": [
                  "asc",
                  "desc",
                ],
                "type": "string",
              },
              "field": {
                "maxLength": 64,
                "pattern": "^[a-z0-9_]+$",
                "type": "string",
              },
            },
            "required": [
              "field",
            ],
            "type": "object",
          },
          "maxItems": 3,
          "type": "array",
        },
        "source": {
          "enum": [
            "learner",
            "learner_course",
            "assessment_result",
            "section_activity",
            "question_result",
            "lesson_progress",
            "login_day",
            "overdue_item",
            "org_member",
            "cohort_summary",
            "overdue_learner",
          ],
          "type": "string",
        },
      },
