exports[`public API course content request contract > ZPublicApiReorderCourseContent keeps its published shape > ZPublicApiReorderCourseContent 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "items": {
      "description": "Sets each item's order and, with sectionId, moves it to another section (null for no section). Orders must be 1, 2, 3, … within each group; an id may appear once per type.",
      "items": {
        "properties": {
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "order": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
          },
          "sectionId": {
            "anyOf": [
              {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
          },
          "type": {
            "enum": [
              "LESSON",
              "EXERCISE",
              "ACTIVITY",
            ],
            "type": "string",
          },
        },
        "required": [
          "id",
          "type",
        ],
        "type": "object",
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array",
    },
    "sections": {
      "description": "Sets the order of these sections, numbered 1, 2, 3, …",
      "items": {
        "properties": {
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "order": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
          },
        },
        "required": [
          "id",
          "order",
        ],
        "type": "object",
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array",
    },
  },
  "type": "object",
}
`;

