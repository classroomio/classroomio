exports[`public API course template contract > ZPublicApiCourseTemplatesQuery keeps its published shape > ZPublicApiCourseTemplatesQuery 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "limit": {
      "default": 20,
      "description": "Items per page, 1-100. Default: 20.",
      "maximum": 100,
      "minimum": 1,
      "type": "integer",
    },
    "page": {
      "default": 1,
      "description": "Page number, starting at 1. Default: 1.",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer",
    },
    "source": {
      "default": "all",
      "description": "org = the organization's own templates, global = curated templates shared with every organization",
      "enum": [
        "all",
        "org",
        "global",
      ],
      "type": "string",
    },
  },
  "type": "object",
}
`;

