exports[`public API organization email template contract > ZPublicApiEmailTemplateResponse keeps its published shape > ZPublicApiEmailTemplateResponse 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "description": "The saved HTML body, or the default when none is saved",
      "type": "string",
    },
    "emailId": {
      "enum": [
        "studentCourseInvite",
        "studentCourseWelcome",
        "studentCourseCompletion",
        "studentOrgInvite",
        "studentCohortWelcome",
        "studentProvePayment",
