        "quizAssigned",
        "sessionReminder",
        "sessionUpdated",
        "submissionGraded",
        "newsfeedPost",
      ],
      "type": "string",
    },
    "hasActionLink": {
      "description": "Whether content may link to {{action_url}}",
      "type": "boolean",
    },
    "isCustomized": {
      "description": "false when the template matches the default",
      "type": "boolean",
    },
    "locale": {
      "enum": [
        "en",
        "hi",
        "fr",
        "pt",
        "de",
        "vi",
        "ru",
        "es",
        "pl",
        "da",
        "tr",
        "it",
      ],
      "type": "string",
    },
    "subject": {
      "description": "The saved subject, or the default when none is saved",
      "type": "string",
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "When the template was last saved; null if it was never saved",
    },
    "variables": {
      "description": "Placeholders allowed in content and subject, written as {{name}}",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
  },
  "required": [
    "emailId",
    "locale",
    "subject",
    "isCustomized",
    "updatedAt",
    "content",
    "variables",
    "hasActionLink",
  ],
  "type": "object",
}
`;

