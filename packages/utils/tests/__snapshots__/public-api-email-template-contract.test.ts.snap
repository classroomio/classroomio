exports[`public API organization email template contract > ZPublicApiSaveEmailTemplate keeps its published shape > ZPublicApiSaveEmailTemplate 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "content": {
      "description": "HTML body. Use only the {{placeholders}} in the template's variables. An <a href="{{action_url}}"> link is allowed only when hasActionLink is true. Unsafe HTML is removed before saving.",
      "maxLength": 50000,
      "minLength": 1,
      "type": "string",
    },
    "subject": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string",
        },
        {
          "type": "null",
        },
      ],
      "description": "Subject line, with the same placeholders as content. Omit to keep the saved subject, or send null to use the default subject.",
    },
  },
  "required": [
    "content",
  ],
  "type": "object",
}
`;

exports[`public API organization email template contract > ZPublicApiSendTestEmailTemplate keeps its published shape > ZPublicApiSendTestEmailTemplate 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "content": {
      "description": "Draft body to test. Omit to test the current template. HTML body. Use only the {{placeholders}} in the template's variables. An <a href="{{action_url}}"> link is allowed only when hasActionLink is true. Unsafe HTML is removed before saving.",
      "maxLength": 50000,
      "minLength": 1,
      "type": "string",
    },
    "recipientEmails": {
      "description": "1 to 5 addresses to send the test to",
      "items": {
        "format": "email",
        "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string",
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array",
    },
    "subject": {
      "description": "Draft subject to test. Omit to test the current subject.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string",
    },
  },
  "required": [
    "recipientEmails",
  ],
  "type": "object",
}
`;
