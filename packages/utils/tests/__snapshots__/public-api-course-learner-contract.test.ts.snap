exports[`public API course learner contract > ZPublicApiCreateLearnerSubmission keeps its published shape > ZPublicApiCreateLearnerSubmission 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "answers": {
      "description": "File-upload and video-recording questions cannot be answered through the API.",
      "items": {
        "properties": {
          "answer": {
            "description": "The answer text, for every other question type.",
            "type": "string",
          },
          "optionId": {
            "description": "The chosen option, for choice questions.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
          "questionId": {
            "description": "Must be a question of this exercise.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer",
          },
        },
        "required": [
          "questionId",
        ],
        "type": "object",
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array",
    },
  },
  "required": [
    "answers",
  ],
  "type": "object",
}
`;

