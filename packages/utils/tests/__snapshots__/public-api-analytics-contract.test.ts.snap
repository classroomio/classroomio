exports[`public API analytics request contract > ZPublicApiMarketingQuery keeps its published shape > ZPublicApiMarketingQuery 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "days": {
      "default": 30,
      "description": "Days counted back from today (UTC): 7, 30, 90 or 365. Default: 30.",
      "type": "number",
    },
    "include": {
      "description": "Sections to return, comma-separated: traffic, countries, funnel, courseTypes, topCourses. Default: traffic.",
      "items": {
        "enum": [
          "traffic",
          "countries",
          "funnel",
          "courseTypes",
          "topCourses",
        ],
        "type": "string",
      },
      "minItems": 1,
      "type": "array",
    },
    "limit": {
      "default": 5,
      "description": "Max rows in list sections (topCourses, countries). 1-20, default 5.",
      "maximum": 20,
      "minimum": 1,
      "type": "integer",
    },
  },
  "type": "object",
}
`;

exports[`public API analytics request contract > ZPublicApiOrganizationOverviewQuery keeps its published shape > ZPublicApiOrganizationOverviewQuery 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "days": {
      "default": 30,
      "description": "Days counted back from today (UTC): 7, 30, 90 or 365. Default: 30.",
      "type": "number",
    },
    "include": {
      "description": "Sections to return, comma-separated: summary, loginActivity. Default: summary.",
      "items": {
        "enum": [
          "summary",
          "loginActivity",
        ],
        "type": "string",
      },
      "minItems": 1,
      "type": "array",
    },
    "limit": {
      "default": 5,
      "description": "Max rows in the summary lists (top courses and recent certificates). 1-20, default 5.",
      "maximum": 20,
      "minimum": 1,
      "type": "integer",
    },
  },
  "type": "object",
}
`;

exports[`public API analytics request contract > ZPublicApiStudentAnalyticsParam keeps its published shape > ZPublicApiStudentAnalyticsParam 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "profileId": {
      "description": "The uuid profileId returned by the compliance and analytics student lists, not the numeric memberId.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string",
    },
  },
  "required": [
    "profileId",
  ],
  "type": "object",
}
`;
