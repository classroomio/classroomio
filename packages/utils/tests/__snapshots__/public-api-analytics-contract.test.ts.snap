// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`public API analytics request contract > ZPublicApiAnalyticsSnapshotQuery keeps its published shape > ZPublicApiAnalyticsSnapshotQuery 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "breakdown": {
      "description": "Course or org scope: how split widgets break the scope down, 'courses' or 'cohorts'. Cohort scope ignores it. Defaults to the split the dashboard picks.",
      "enum": [
        "courses",
        "cohorts",
      ],
      "type": "string",
    },
    "courseId": {
      "description": "Course the per-course widgets focus on. Organization and cohort snapshots omit per-course widgets unless you pass it. A course outside the scope fails with 404.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string",
    },
    "exerciseId": {
      "description": "Per-exercise widgets focus on this exercise; defaults to the last pass-required exercise. Outside the selected course it fails with 404.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string",
    },
    "range": {
      "description": "Data range for every widget: 'all', '7d', '30d' or '90d'. Default: 'all'.",
      "enum": [
        "all",
        "7d",
        "30d",
        "90d",
      ],
      "type": "string",
    },
  },
  "type": "object",
}
`;

exports[`public API analytics request contract > ZPublicApiAnalyticsStudentsQuery keeps its published shape > ZPublicApiAnalyticsStudentsQuery 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "courseId": {
      "description": "Limit the table to one course inside the scope.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string",
    },
    "dir": {
      "description": "Sort direction; without it at-risk comes first for status, lowest progress or score first, names A–Z, newest login first.",
      "enum": [
        "asc",
        "desc",
      ],
      "type": "string",
    },
    "isOverdue": {
      "anyOf": [
        {
          "type": "boolean",
        },
        {
          "enum": [
            "true",
            "false",
          ],
          "type": "string",
        },
      ],
      "description": "true lists only students with an overdue item, false only those without; omit to list both.",
    },
    "limit": {
      "default": 20,
      "description": "Items per page, 1-100. Default: 20.",
      "maximum": 100,
      "minimum": 1,
      "type": "integer",
    },
    "page": {
      "default": 1,
      "description": "Page number, starting at 1, at most 4000.",
      "maximum": 4000,
      "minimum": 1,
      "type": "integer",
    },
    "search": {
      "description": "Match the student name or email, at most 100 characters.",
      "maxLength": 100,
      "type": "string",
    },
    "sort": {
      "default": "status",
      "description": "'status', 'name', 'progress', 'score' or 'lastLogin'. Default: 'status'.",
      "enum": [
        "status",
        "name",
        "progress",
        "score",
        "lastLogin",
      ],
      "type": "string",
    },
    "status": {
      "description": "'at_risk', 'lagging', 'on_track' or 'completed'.",
      "enum": [
        "at_risk",
        "lagging",
        "on_track",
        "completed",
      ],
      "type": "string",
    },
  },
  "type": "object",
}
`;

