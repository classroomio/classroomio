exports[`public API analytics request contract > ZPublicApiOrgAnalyticsQuery keeps its published shape > ZPublicApiOrgAnalyticsQuery 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "days": {
      "default": 30,
      "description": "Window in days, counted back from today (UTC): 7, 30, 90 or 365. Default: 30. Applies to every time-windowed section.",
      "type": "number",
    },
    "include": {
      "description": "Comma-separated sections to return: overview, traffic, countries, funnel, courseTypes, topCourses, loginActivity, compliance. Default: overview. overview: totals (courses, students, certificates), top courses by students, and recent certificates. traffic: landing and course page views, unique visitors, enrollments and completions, with a per-day series. countries: views and enrollments by visitor country. funnel: landing view → course page view → enrollment → completion; for one course, use GET /courses/{courseId}/analytics?include=funnel. courseTypes: views, enrollments and completions by course type. topCourses: the most viewed course pages. loginActivity: student logins by day of week (org admin only). compliance: compliance status counts, overall and per course (org admin only); list the learners with GET /analytics/compliance/learners.",
      "items": {
        "enum": [
          "overview",
          "traffic",
          "countries",
          "funnel",
          "courseTypes",
          "topCourses",
          "loginActivity",
          "compliance",
        ],
        "type": "string",
      },
      "minItems": 1,
      "type": "array",
    },
    "limit": {
      "default": 5,
      "description": "Max rows in list sections (overview lists, topCourses, countries). 1-20, default 5.",
      "maximum": 20,
      "minimum": 1,
      "type": "integer",
    },
  },
  "type": "object",
}
`;
