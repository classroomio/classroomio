{
  "name": "@cio/landing-pages",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "default": "./dist/templates/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc && tsc-alias",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cio/tsconfig": "workspace:*",
    "@cio/utils": "workspace:*",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.5.2",
    "vitest": "^1.2.2"
  }
}
