# Used by drizzle-kit migrate, db:setup, and the app when PGBOUNCER_DATABASE_URL is unset.
# Matches the local Postgres started by docker/docker-compose.yaml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classroomio"

# Optional. App runtime uses this when set.
# PGBOUNCER_DATABASE_URL=

# Optional. Comma-separated redirect URIs from Zapier Developer Platform (used by oauth:register-client)
# ZAPIER_OAUTH_REDIRECT_URIS="https://zapier.com/dashboard/auth/oauth/return/App<ID>API/"
