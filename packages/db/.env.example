# App traffic. On PlanetScale use the PgBouncer port (6432).
# Matches the local Postgres started by docker/docker-compose.yaml.
# db:migrate / db:setup rewrite :6432 to :5432 automatically so a Render
# pre-deploy hook can share this env with the API.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classroomio"

# Optional override when migrate must not derive :5432 from DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classroomio"
