reporter=append-only

# Pin pnpm's default isolated linker. A global `node-linker=hoisted` flattens the
# tree and gives svelte, @sveltejs/kit and @sveltejs/acorn-typescript separate
# `acorn` copies, which breaks `Parser.extend(tsPlugin())` — every `<script lang="ts">`
# then fails to parse with "Unexpected token" during `vite build`.
node-linker=isolated
